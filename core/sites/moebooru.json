{
  "engine": "moebooru",
  "description": "Moebooru API (konachan.com, yande.re)",
  "known_hosts": [
    "konachan.com",
    "konachan.net",
    "yande.re"
  ],
  "requires_auth": false,
  "cf_protected": [],
  "md5_search": [
    {
      "path": "/post/index.json",
      "params": {
        "tags": "md5:{md5}",
        "limit": 1
      },
      "format": "json"
    },
    {
      "path": "/post/index.json",
      "params": {
        "tags": "{md5}",
        "limit": 1
      },
      "format": "json"
    },
    {
      "path": "/posts.json",
      "params": {
        "tags": "md5:{md5}",
        "limit": 1
      },
      "format": "json"
    },
    {
      "path": "/posts.json",
      "params": {
        "md5": "{md5}",
        "limit": 1
      },
      "format": "json"
    }
  ],
  "post_fields": {
    "id": [
      "id"
    ],
    "md5": [
      "md5"
    ],
    "tags": [
      "tags"
    ],
    "file_url": [
      "file_url"
    ],
    "rating": [
      "rating"
    ],
    "source": [
      "source"
    ]
  },
  "post_list_path": [
    null
  ],
  "post_url": "{root}/post/show/{id}"
}
