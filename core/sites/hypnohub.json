{
  "engine": "hypnohub",
  "description": "HypnoHub Gelbooru-compatible DAPI: exact MD5 through JSON post listing",
  "known_hosts": [
    "hypnohub.net"
  ],
  "requires_auth": false,
  "cf_protected": [],
  "md5_search": [
    {
      "path": "/index.php",
      "params": {
        "page": "dapi",
        "s": "post",
        "q": "index",
        "json": "1",
        "tags": "md5:{md5}",
        "limit": 1
      },
      "format": "json"
    }
  ],
  "post_fields": {
    "id": [
      "id"
    ],
    "md5": [
      "md5",
      "hash"
    ],
    "tags": [
      "tags",
      "tag_string"
    ],
    "file_url": [
      "file_url",
      "image"
    ],
    "rating": [
      "rating"
    ],
    "source": [
      "source"
    ]
  },
  "post_list_path": [
    "post",
    "@post",
    null
  ],
  "post_url": "{root}/index.php?page=post&s=view&id={id}"
}
