{
  "engine": "hypnohub",
  "description": "Hypnohub - Danbooru fork, requires auth for API",
  "known_hosts": ["hypnohub.net"],
  "requires_auth": true,
  "cf_protected": [],
  "md5_search": [
    {"path": "/posts.json", "params": {"tags": "md5:{md5}", "limit": 1}, "format": "json"},
    {"path": "/posts.json", "params": {"search[md5]": "{md5}", "limit": 1}, "format": "json"}
  ],
  "post_fields": {
    "id":       ["id"],
    "md5":      ["md5"],
    "tags":     ["tag_string", "tags"],
    "file_url": ["file_url"],
    "rating":   ["rating"],
    "source":   ["source"]
  },
  "post_list_path": ["posts", null],
  "post_url": "{root}/posts/{id}"
}
