* text=auto eol=lf

# Windows scripts must stay CRLF for cmd.exe compatibility
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Python / project text
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp4 binary
*.webm binary
*.mkv binary
*.zip binary
*.7z binary
*.exe binary
*.dll binary
*.pyd binary
*.onnx binary
*.pt binary
*.pth binary
*.safetensors binary
*.bin binary
*.gguf binary
